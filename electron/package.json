{
  "name": "gmini-agent-ui",
  "version": "0.3.1",
  "description": "G-Mini Agent: agente de IA de escritorio",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "fetch:uv": "node scripts/fetch-uv.js",
    "build": "electron-builder",
    "dist:win": "node scripts/fetch-uv.js win && electron-builder --win --publish never",
    "dist:linux": "node scripts/fetch-uv.js linux && electron-builder --linux --publish never",
    "vendor:skin": "node scripts/copy-skin-vendor.js"
  },
  "dependencies": {
    "@pixiv/three-vrm": "^3.4.1",
    "js-yaml": "^4.3.2",
    "socket.io-client": "^4.7.5",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.gmini.agent",
    "productName": "G-Mini Agent",
    "copyright": "Copyright (c) 2024-2026 G-Mini Agent",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "setup-preload.js",
      "runtime-setup.js",
      "src/**/*",
      "assets/**/*",
      "package.json",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "../backend",
        "to": "core/backend",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      },
      {
        "from": "../data",
        "to": "core/data",
        "filter": [
          "prompts/**/*",
          "skills/**/*",
          "agent_skills/bundled/**/*",
          "crews/**/*",
          "commands/**/*",
          "models.yaml",
          "realtime_models.yaml",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      },
      {
        "from": "../config.default.yaml",
        "to": "core/config.default.yaml"
      },
      {
        "from": "../LICENSE",
        "to": "core/LICENSE"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "extraResources": [
        {
          "from": "build/uv/win",
          "to": "uv",
          "filter": [
            "uv.exe"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "G-Mini Agent",
      "uninstallDisplayName": "G-Mini Agent",
      "artifactName": "G-Mini-Agent-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "icon": "assets/linux-icons",
      "category": "Utility",
      "extraResources": [
        {
          "from": "build/uv/linux",
          "to": "uv",
          "filter": [
            "uv"
          ]
        }
      ],
      "artifactName": "G-Mini-Agent-${version}.${ext}",
      "maintainer": "G-Mini Agent <angelgabrieljacintohuayllasco@gmail.com>",
      "synopsis": "Agente de IA de escritorio",
      "description": "Agente de IA que ve tu pantalla, usa el mouse, el teclado y el navegador, recuerda lo que le cuentas y habla. La primera vez prepara su propio Python con uv.",
      "desktop": {
        "entry": {
          "StartupWMClass": "gmini-agent-ui"
        }
      }
    },
    "deb": {
      "artifactName": "g-mini-agent_${version}_${arch}.${ext}",
      "packageName": "g-mini-agent"
    },
    "rpm": {
      "artifactName": "g-mini-agent-${version}.${arch}.${ext}",
      "packageName": "g-mini-agent"
    }
  },
  "author": {
    "name": "G-Mini Agent",
    "email": "angelgabrieljacintohuayllasco@gmail.com"
  },
  "homepage": "https://github.com/angelgabrieljacintohuayllasco/G-Mini-Agent",
  "license": "MIT"
}
